 		return NF_ACCEPT;
 	}
 
+#ifdef ECM_INTERFACE_MACVLAN_ENABLE
+	/*
+	 * A non-private MACVLAN is never accelerated; don't build and tear down
+	 * a connection on every packet to find that out. Counted as no-offload.
+	 */
+	if (ecm_interface_is_unaccelerable_macvlan(out) || ecm_interface_is_unaccelerable_macvlan(in)) {
+		dev_put(in);
+		ecm_stats_v4_inc(ECM_STATS_V4_EXCEPTION_CMN, ECM_STATS_V4_EXCEPTION_ROUTE_OUT_IFF_NO_OFFLOAD);
+		return NF_ACCEPT;
+	}
